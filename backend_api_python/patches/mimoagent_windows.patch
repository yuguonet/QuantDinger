+def _find_git_bash_exe() -> str:
+    """定位 Git for Windows 的 bash.exe（POSIX 执行后端）。"""
+    candidates = []
+    for d in _locate_git_bin_dirs():
+        parent = os.path.dirname(d)
+        candidates.append(os.path.join(d, "bash.exe"))
+        candidates.append(os.path.join(parent, "bin", "bash.exe"))
+        candidates.append(os.path.join(parent, "bash.exe"))
+    for c in candidates:
+        if os.path.isfile(c):
+            return c
+    return ""
