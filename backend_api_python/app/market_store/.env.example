# ============================================================
# Market Data Store — 环境变量配置 (Pickle 格式)
# ============================================================

# 数据保留天数，超过自动删除，默认 15
MARKET_RETENTION_DAYS=15

# 数据存储目录（相对于本脚本的路径，或绝对路径）
# 单个 pickle 文件: {MARKET_DATA_DIR}/market_store.pkl
MARKET_DATA_DIR=./data

# 是否在启动时打印详细日志
MARKET_VERBOSE=1

# ============================================================
# 急剧变化检测配置
# ============================================================

# 回看最近 N 条历史数据进行比对（默认 15）
MARKET_ANOMALY_WINDOW=15

# z-score 阈值：变动偏离历史均值多少个标准差算"急剧"（默认 2.5）
MARKET_ANOMALY_ZSCORE=2.5

# 最小变动百分比：低于此值不告警，过滤正常波动（默认 2.0%）
MARKET_ANOMALY_MIN_PCT=2.0

# 同一标的告警冷却时间（秒），防止刷屏（默认 600 = 10分钟）
MARKET_ANOMALY_COOLDOWN=600

# ============================================================
# 容错 & 数据质量配置
# ============================================================

# 单次最大合理价格变动%（超过视为采集错误，丢弃该数据，默认 50%）
MARKET_SANITY_MAX_PCT=50.0

# 最低采集完整率（实际采集数/预期数，低于此值不触发异常检测，默认 0.5 = 50%）
MARKET_MIN_FETCH_RATIO=0.5

# 是否启用缺失数据回填（1=开启，采集不到的标的沿用上次数据，默认开启）
MARKET_FILL_MISSING=1
