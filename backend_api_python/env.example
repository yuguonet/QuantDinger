# QuantDinger local configuration (copy to `.env` and edit)
# `run.py` will load `backend_api_python/.env` automatically if present.
#
# This file is organized as:
# 1) first-time deployment settings at the top
# 2) advanced / rarely changed settings at the bottom
# For Docker image source / ports, use the project-root `.env`.

# =========================
# Auth (required)
# =========================
# Also derives Fernet key for encrypting qd_exchange_credentials.encrypted_config (do not rotate casually).
SECRET_KEY=quantdinger-secret-key-change-me
ADMIN_USER=quantdinger
ADMIN_PASSWORD=123456
ADMIN_EMAIL=

# =========================
# Core app
# =========================
DATABASE_URL=postgresql://quantdinger:quantdinger123@postgres:5432/quantdinger
FRONTEND_URL=http://localhost:8888
ENABLE_REGISTRATION=true

# =========================
# Agent conversation memory
# =========================
# agent.py: MEMORY_BACKEND 决定对话记忆后端。
#   - postgres: 持久化到库 + 跨进程/重启共享；B.1 受控检索通道的前提（需 DATABASE_URL）
#   - 留空或 local: 进程内内存（重启即丢、多 worker 不共享）——不推荐生产
# ⚠ 若设为 postgres 但 DATABASE_URL 为空，会告警并回退 LocalMemory。
MEMORY_BACKEND=postgres
# 单会话保留的最大历史条数（超出按策略裁剪）。
#AGENT_MEMORY_MAX_HISTORY=2000
# 开启对话历史受控检索（B.1）；仅在 MEMORY_BACKEND=postgres 时生效。
CHAT_HISTORY_SEARCH_ENABLED=true

# =========================
# Market DB (multi-market kline storage)
# =========================
# db_market.py: 每个市场独立数据库（cn_db, us_db, hk_db ...）
# 连接凭据（host/port/user/password）从 DATABASE_URL 解析，无需重复配置。
#
# STRATEGY_DB_NAME: strategy_db 的真实库名（用于 FDW 桥接）。
#   - 留空则自动取 DATABASE_URL 中的 dbname
#   - 如果你的 strategy_db 和 DATABASE_URL 的 dbname 不同，在此显式指定
#STRATEGY_DB_NAME=quantdinger

# 市场库连接池配置（每个市场库独立池，不影响 strategy_db 的连接池）
MARKET_DB_POOL_MIN=2
MARKET_DB_POOL_MAX=10
MARKET_DB_POOL_ACQUIRE_TIMEOUT=10

# =========================
# Database connection pool (psycopg2 ThreadedConnectionPool)
# =========================
# Tune these if you see `psycopg2.pool.PoolError: connection pool exhausted`
# or if you run many trading bots / portfolios concurrently.
# Make sure PG `max_connections` (docker-compose: PG_MAX_CONNECTIONS) is
# comfortably larger than DB_POOL_MAX.
DB_POOL_MIN=5
DB_POOL_MAX=50
DB_POOL_ACQUIRE_TIMEOUT=10
DB_POOL_HEALTH_CHECK=true

# Route-level parallel fetch executors.  Each worker may hold one DB
# connection, so keep MARKET_EXECUTOR_WORKERS + PORTFOLIO_EXECUTOR_WORKERS
# well below DB_POOL_MAX.
MARKET_EXECUTOR_WORKERS=6
PORTFOLIO_EXECUTOR_WORKERS=3

# Gunicorn worker/thread model
GUNICORN_WORKERS=1
GUNICORN_THREADS=8

# =========================
# AI / LLM (choose one provider)
# =========================
LLM_PROVIDER=openrouter

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o
# Optional: dedicated model for AI code generation (fallback to provider default if empty)
AI_CODE_GEN_MODEL=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-flash

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

GROK_API_KEY=
GROK_MODEL=grok-beta

# =========================
# Common background jobs
# =========================
ENABLE_PENDING_ORDER_WORKER=true
ENABLE_PORTFOLIO_MONITOR=true
DISABLE_RESTORE_RUNNING_STRATEGIES=false

# =========================
# Email / SMTP (optional)
# =========================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# =========================
# Proxy (optional)
# =========================
# PROXY_URL=socks5h://127.0.0.1:10808         # local
# PROXY_URL=socks5h://host.docker.internal:10808  # Docker
PROXY_URL=

# Outbound HTTPS to exchanges when using PROXY_URL (especially SOCKS). If you see
# SSLCertVerificationError / "unable to get local issuer certificate":
# - Prefer: install OS ca-certificates in the image, or point to a PEM bundle:
#   LIVE_TRADING_CA_BUNDLE=/path/to/ca-bundle.pem
#   (REQUESTS_CA_BUNDLE / SSL_CERT_FILE are also honored.)
# - Last resort only: LIVE_TRADING_SSL_VERIFY=false  # disables TLS verify — insecure
#LIVE_TRADING_CA_BUNDLE=
#LIVE_TRADING_SSL_VERIFY=

# =========================
# Captcha / OAuth (optional)
# =========================
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/oauth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5000/api/auth/oauth/github/callback

# =========================
# Billing / payments
# =========================
BILLING_ENABLED=false

# 积分单价
BILLING_COST_AI_ANALYSIS=10
BILLING_COST_AI_CODE_GEN=30

CREDITS_REGISTER_BONUS=100
CREDITS_REFERRAL_BONUS=50

# Membership plans
MEMBERSHIP_MONTHLY_PRICE_USD=19.9
MEMBERSHIP_YEARLY_PRICE_USD=199
MEMBERSHIP_LIFETIME_PRICE_USD=499
MEMBERSHIP_MONTHLY_CREDITS=500
MEMBERSHIP_YEARLY_CREDITS=8000
MEMBERSHIP_LIFETIME_MONTHLY_CREDITS=800

# USDT payment
USDT_PAY_ENABLED=false
USDT_PAY_CHAIN=TRC20
USDT_TRC20_XPUB=
USDT_TRC20_CONTRACT=TXLAQ63Xg1NAzckPwKHvzw7CSEmLMEqcdj
TRONGRID_BASE_URL=https://api.trongrid.io
TRONGRID_API_KEY=
USDT_PAY_CONFIRM_SECONDS=30
USDT_PAY_EXPIRE_MINUTES=30
USDT_WORKER_POLL_INTERVAL=30

# =========================
# Advanced / rarely changed
# =========================

# Network / App tuning
PYTHON_API_HOST=0.0.0.0
PYTHON_API_PORT=5000
PYTHON_API_DEBUG=false
RATE_LIMIT=100
ENABLE_CACHE=false
ENABLE_REQUEST_LOG=true

# Strategy / execution tuning
PENDING_ORDER_STALE_SEC=90
ORDER_MODE=market
MAKER_WAIT_SEC=10
MAKER_OFFSET_BPS=2
STRATEGY_TICK_INTERVAL_SEC=10
PRICE_CACHE_TTL_SEC=10
K_LINE_HISTORY_GET_NUMBER=500
SIGNAL_NOTIFY_TIMEOUT_SEC=6

# LLM advanced tuning
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_TEMPERATURE=0.7
OPENROUTER_MAX_TOKENS=4000
OPENROUTER_TIMEOUT=300
OPENROUTER_CONNECT_TIMEOUT=30
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
GROK_BASE_URL=https://api.x.ai/v1

# Agent 模型配置（可选，留空则使用 LLM_PROVIDER 对应的默认模型）
# 主 Agent 模型（对话/分析/代码生成）
AGENT_LLM_MODEL=

# LLM 网关抖动重试（远端网关偶发 5xx 时提高成功率；本地 llama 稳定可保持默认）
# SDK 层内置重试次数（秒级抖动，间隔毫秒级，OpenAI SDK 标准 max_retries）
LLM_MAX_RETRIES=3
# 退避重试轮数（SDK 重试用尽后的兜底，覆盖网关重启等分钟级窗口；2s/4s/8s 指数退避，封顶 15s）
# 总尝试次数 = (LLM_MAX_RETRIES+1) × LLM_RETRY_ROUNDS，有界不死循环
LLM_RETRY_ROUNDS=3

# 注（2026-09-19 S7）：原 §17.2 的 PLAN_MAX_PHASES / PLAN_PHASE_MAX_RETRIES /
# PLAN_PHASE_FAST_EXIT_STEPS 三个声明从未被代码 getenv 读取（零接线死声明），且数值与
# task_agent.py 顶部模块常量（PLAN_MAX_PHASES=5 / PLAN_PHASE_MAX_RETRIES=1 /
# PLAN_PHASE_MAX_STEPS=12）不一致，已移除以免误导。阶段数上限的单一事实源见
# task_agent.py 模块常量（姊妹项 PLAN_TOOL_LIST_LIMIT / CAP_PLAN_LIST_LIMIT 才是
# env 驱动，见其 getenv 读取处）。
# 上下文压缩模型（轻量即可，推荐 qwen2.5:7b / deepseek-chat）
AGENT_COMPRESS_MODEL=
# Embedding 模型（向量检索，推荐 nomic-embed-text / text-embedding-3-small）
AGENT_EMBED_MODEL=

# Data sources
DATA_SOURCE_TIMEOUT=30
DATA_SOURCE_RETRY=3
DATA_SOURCE_RETRY_BACKOFF=0.5
FINNHUB_API_KEY=
FINNHUB_TIMEOUT=10
FINNHUB_RATE_LIMIT=60
CCXT_DEFAULT_EXCHANGE=coinbase
CCXT_TIMEOUT=10000
AKSHARE_TIMEOUT=30
YFINANCE_TIMEOUT=30
TIINGO_API_KEY=
TIINGO_TIMEOUT=10

# Twelve Data (CN/HK stock K-lines — recommended for overseas servers)
# Free tier: 800 API credits/day, 8 requests/minute. https://twelvedata.com
TWELVE_DATA_API_KEY=

# AI search / news
SEARCH_PROVIDER=google
SEARCH_MAX_RESULTS=10
SEARCH_GOOGLE_API_KEY=
SEARCH_GOOGLE_CX=
SEARCH_BING_API_KEY=
TAVILY_API_KEYS=
SERPAPI_KEYS=
BOCHA_AI_API_KEY=
BAIDU_SEARCH_API_KEY=
# SMS / phone (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Security / verification tuning
SECURITY_IP_MAX_ATTEMPTS=10
SECURITY_IP_WINDOW_MINUTES=5
SECURITY_IP_BLOCK_MINUTES=15
SECURITY_ACCOUNT_MAX_ATTEMPTS=5
SECURITY_ACCOUNT_WINDOW_MINUTES=60
SECURITY_ACCOUNT_BLOCK_MINUTES=30
VERIFICATION_CODE_EXPIRE_MINUTES=10
VERIFICATION_CODE_RATE_LIMIT=60
VERIFICATION_CODE_IP_HOURLY_LIMIT=10
VERIFICATION_CODE_MAX_ATTEMPTS=5
VERIFICATION_CODE_LOCK_MINUTES=30

# AI analysis tuning
ENABLE_CONFIDENCE_CALIBRATION=false
ENABLE_AI_ENSEMBLE=false
AI_ENSEMBLE_MODELS=openai/gpt-4o,openai/gpt-4o-mini
ENABLE_REFLECTION_WORKER=false
REFLECTION_WORKER_INTERVAL_SEC=86400
REFLECTION_MIN_AGE_DAYS=7
REFLECTION_VALIDATE_LIMIT=200
AI_CALIBRATION_MARKETS=Crypto
AI_CALIBRATION_LOOKBACK_DAYS=30
AI_CALIBRATION_MIN_SAMPLES=80
AI_ANALYSIS_CONSENSUS_TIMEFRAMES=1D,4H

# Redis cache (auto-configured by docker-compose; set CACHE_ENABLED=true to use)
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_ENABLED=true

# Internal
INTERNAL_API_KEY=


# ============================================================
# Agent 扫描与自修改控制
# ============================================================

# 允许 Agent 扫描项目源码（只读），用于代码理解和分析
# true = Agent 可以读取项目中的 .py / .vue / .js 等源码
# false = Agent 只能访问工作区（workspace）内的文件
AGENT_SCAN_PROJECT_READONLY=true

# Agent 可扫描的路径（逗号分隔，相对于项目根目录）
# 空 = 默认扫描 backend_api_python/app/agent/tools, backend_api_python/app/services,
#       QuantDinger-Vue/src/api, QuantDinger-Vue/src/views
AGENT_SCAN_PATHS=

# 允许 Agent 自修改指定目录下的文件
# true = Agent 可以读写 AGENT_SELF_MODIFY_PATHS 中列出的目录（自动备份）
# false = 所有目录只读（默认）
AGENT_TOOLS_SELF_MODIFY=false

# 允许 Agent 修改的目录列表（逗号分隔，相对于项目根目录）
# 默认: backend_api_python/app/agent/tools
# 示例: backend_api_python/app/agent/tools,backend_api_python/app/services,scripts,optimizer
AGENT_SELF_MODIFY_PATHS=backend_api_python/app/agent/tools

# 【已移除的死开关（2026-09-17 清理，v2.4 待办清零）】
# - AGENT_TYPE：曾声称可切 CodeAgent/ToolCallingAgent，但代码从未读取（实际恒为 CodeAgent）。
#   ToolCallingAgent 形态属未实施设计（docs/AGENT_EXEC_MODE_DESIGN.md，评审通过后再接线，
#   届时才恢复本开关）。
# - CODE_EXECUTION_TIMEOUT：从未被任何代码读取；真实生效的沙箱超时是 CODE_EXEC_TIMEOUT。
#   二者仅差两个字母，属误导性近似名，已删——勿再新增 CODE_EXECUTION_TIMEOUT。
#
# 代码执行超时（秒），默认 120。smolagents CodeAgent 的 Python 沙箱单步超时。
# 真实读取点：agents/task_agent.py 的 os.getenv("CODE_EXEC_TIMEOUT")。
# 批量工具调用（如循环获取多只股票行情）可能需要更长时间。
CODE_EXEC_TIMEOUT=120

# ============================================================
# Market Data Feather Store — 环境变量配置
# ============================================================

# 数据采集间隔（秒），默认 300 = 5分钟
FEATHER_FETCH_INTERVAL=300

# 数据保留天数，超过自动删除，默认 15
FEATHER_RETENTION_DAYS=15

# feather 文件存储目录（相对于本脚本的路径，或绝对路径）
FEATHER_DATA_DIR=./data/feather

# 是否在启动时打印详细日志
FEATHER_VERBOSE=1

# ============================================================
# 急剧变化检测配置
# ============================================================

# 回看最近 N 条历史数据进行比对（默认 15）
FEATHER_ANOMALY_WINDOW=15

# z-score 阈值：变动偏离历史均值多少个标准差算"急剧"（默认 2.5）
FEATHER_ANOMALY_ZSCORE=2.5

# 最小变动百分比：低于此值不告警，过滤正常波动（默认 2.0%）
FEATHER_ANOMALY_MIN_PCT=2.0

# 同一标的告警冷却时间（秒），防止刷屏（默认 600 = 10分钟）
FEATHER_ANOMALY_COOLDOWN=600

# ============================================================
# 容错 & 数据质量配置
# ============================================================

# 单次最大合理价格变动%（超过视为采集错误，丢弃该数据，默认 50%）
FEATHER_SANITY_MAX_PCT=50.0

# 最低采集完整率（实际采集数/预期数，低于此值不触发异常检测，默认 0.5 = 50%）
FEATHER_MIN_FETCH_RATIO=0.5

# 是否启用缺失数据回填（1=开启，采集不到的标的沿用上次数据，默认开启）
FEATHER_FILL_MISSING=1

# ============================================================
# 板块历史采集（每日收盘后采集行业/概念板块排名，保留6个月）
# ============================================================

# 是否启用板块历史采集（默认关闭，设 true 开启）
SECTOR_HISTORY_ENABLED=false

# 每日采集时间（收盘后，默认 15:30）
SECTOR_COLLECT_HOUR=15
SECTOR_COLLECT_MINUTE=30

# 保留天数（默认 200 天 ≈ 6.5 个月）
SECTOR_RETENTION_DAYS=200

# 每日存储前 N 个板块（默认 30）
SECTOR_TOP_N=30

# ============================================================
# Agent 能力层与 token 治理（代码实际读取，2026-09-18 补声明）
# ============================================================

# 能力发现层开关：默认开启（admission.json 69 项只读函数准入）；设 0 显式关闭
# CAPABILITIES_ENABLED=1

# plan 提示"数据能力"段条数上限（按与用户输入的相关度截断，被裁数量会告知 planner）
# CAP_PLAN_LIST_LIMIT=30

# planner 工具清单条数上限（超出按相关度截断，非字母序）
# PLAN_TOOL_LIST_LIMIT=60

# 沙箱单步 print 上限（字符；超出替换为占位提示，数据仍在变量里）
# CODE_MAX_PRINT_CHARS=1200

# CodeAgent 单次生成上限（smolagents 默认 2048 会截断完整代码块）
# CODE_AGENT_MAX_TOKENS=4096

# ============================================================
# 成本硬预算 + 计数器面板（提智方案 阶段 0.9，2026-09-24）
# ============================================================

# 单 run token 预算：执行中每步累加 input+output，超限即注入软收尾提示（不硬崩）
AGENT_RUN_TOKEN_BUDGET=200000

# 单 run 工具调用预算（去伪工具名后的真实调用数）
AGENT_RUN_TOOL_CALL_BUDGET=60

# 单用户/会话日 token 配额（进程内记账，日切由调度重置）
AGENT_DAY_TOKEN_QUOTA=2000000

# 计数器面板落盘路径（相对 app/agent/ 解析）；供 scripts/weekly_panel.py 聚合
# AGENT_PANEL_FILE=traces/panel.jsonl


# ============================================================
# 难度路由 · 模型档位（提智批 2026-09-30，routing_policy.tier_model）
# ============================================================

# L0/L1 降档启用闸：1=允许小模型跑 L0/L1（需评测集先证掉点 <5pp 才开）；默认 0
# AGENT_ROUTING_DOWNGRADE=0

# 档位模型名（空 = 沿用 LLM_MODEL 默认）。strong 对 L2/L3 配置即生效；
# small 仅在 AGENT_ROUTING_DOWNGRADE=1 时生效
# AGENT_MODEL_TIER_SMALL=
# AGENT_MODEL_TIER_STRONG=

# 阶段重试上下文收敛（提智批 2026-09-30，8.5）：重试复用 CodeAgent 时 memory 保留的
# 最近步数上限（旧步丢弃防 input 爆炸；变量在 executor.state 不受影响）
# AGENT_RETRY_KEEP_STEPS=6


# ============================================================
# v5 条件化预测引擎（C3P + 条件校准，2026-10-14 P3 接线）
# ============================================================

# C3P 总开关（证据抽取 + 配对双跑 + 校准）。0=整条旁路跳过
# QD_C3P_ENABLED=1

# 一次推理最多处理几条 claim（控成本，不是控正确性）
# QD_C3P_MAX_CLAIMS=2

# 配对记录落盘目录（默认 <backend>/data/pairs）
# QD_PAIR_DIR=

# ── 条件校准（P3：pairs × resolutions → β₀）────────────────────
# 校准总开关。0=coefs_for() 恒返回 None（Δp 恒为 0，等同冷启动行为）
# QD_CALIB_ENABLED=1

# 每格出 β₀ 所需的**独立簇**数（不是名义样本数；年 361 簇 / 12 格 ≈ 30）
# QD_CALIB_MIN_CLUSTERS=30

# 系数有效期（天），季度重估；过期不删（留着审计）但 usable=False
# QD_CALIB_TAU_DAYS=90

# 参与校准的 claim horizon。★ 必须与 p_base 口径一致：
#   p_base 来自 predict_next_day（**次日**概率）⇒ 默认只收 T+1；
#   拿 T+3 的判定去校准次日概率是口径错配（A 尺子量 B）
# QD_CALIB_HORIZON=T+1

# 同日标的平均相关系数 ρ（默认取 app.utils.stat_power.RHO_BAR=0.2191，v4 实测）
# QD_CALIB_RHO=0.2191

# 进程内缓存秒数（避免每次推理都重扫全量 pair）。0=每次重算
# QD_CALIB_CACHE_SEC=1800

# 只看最近 N 天的 pair。0=全量（样本本来就不多，早期砍窗口只会让格子更达不到门槛）
# QD_CALIB_LOOKBACK_DAYS=0

# 系数落盘目录（默认 <backend>/data/calib）。τ 内跨进程复用 ——
#   不落盘则每次冷启动都重拟合，fitted_at 恒为 now ⇒ τ 形同虚设
# QD_CALIB_DIR=

# ============================================================
# O-11 小项（2026-10-14）：会话去重表容量 + 元工具名单
# ============================================================

# 会话级技能去重表 `_skill_seen` 的**会话容量上限**（LRU，默认 512）。
#   原实现只增不减 = 长跑内存增长点（设计 D-12）。
#   淘汰只影响"正文 vs 一行指针"：被淘汰的会话下次重注一次正文，正确性不变。
#   脏值/非正值一律夹紧到 >=1（0 会让去重表变永空集 ⇒ 每轮重复灌正文）
# QD_SKILL_SEEN_MAX=512

# 技能酿造写盘前要从 tools 白名单里剔除的"元工具"名单（逗号分隔，默认见代码
#   _META_TOOLS_DEFAULT）。留空 = 未配置 = 回落默认（**不是空名单**）。
#   为什么不能省：list_tools/search_tools/final_answer/python_interpreter 是框架
#   内置，不进 ToolProvider 注册表 ⇒ 无法从 provider 推导，只能显式配置（D-11）
# QD_META_TOOLS=
